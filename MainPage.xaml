<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ytDownloader.MainPage"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Resources>
        <Color x:Key="BgColor">#181818</Color>
        <Color x:Key="PanelBgColor">#222222</Color>
        <Color x:Key="CardBgColor">#2A2A2A</Color>
        <Color x:Key="TextColor">#FFFFFF</Color>
        <Color x:Key="SubTextColor">#AAAAAA</Color>
        <Color x:Key="AccentColor">#E50914</Color>
        <Color x:Key="EntryBgColor">#333333</Color>
        <Color x:Key="BorderColor">#3D3D3D</Color>
    </ContentPage.Resources>

    <!-- Maksimum genişlik daraltıldı, ferahlık için padding azaltıldı -->
    <ScrollView>
        <VerticalStackLayout Padding="15,20" Spacing="12" MaximumWidthRequest="800" HorizontalOptions="Center">

            <!-- ÜST BİLGİ (HEADER) -->
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Border BackgroundColor="{DynamicResource AccentColor}" WidthRequest="35" HeightRequest="35" Stroke="Transparent">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Label Text="▶" FontSize="16" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label Text="Youtube İndirici" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                        <Label Text="UI Pro Kompakt" FontSize="11" TextColor="{DynamicResource AccentColor}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Button Grid.Column="1" Text="⚙️ Ayarlar" BackgroundColor="{DynamicResource PanelBgColor}" TextColor="{DynamicResource TextColor}" CornerRadius="8" Clicked="OnSettingsClicked" Padding="15,0" HeightRequest="35" FontAttributes="Bold" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" FontSize="12"/>
            </Grid>

            <!-- AYARLAR KARTI (Sıkıştırılmış) -->
            <Border x:Name="SettingsPanel" IsVisible="False" BackgroundColor="{DynamicResource PanelBgColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="🛠️ Uygulama Tercihleri" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" FontSize="14" />
                    <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Panodan Otomatik Algıla" TextColor="{DynamicResource SubTextColor}" FontSize="12" VerticalOptions="Center"/>
                                <Switch x:Name="AutoPasteSwitch" Grid.Column="1" Scale="0.8" OnColor="{DynamicResource AccentColor}" />
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Algılayınca Öne Getir" TextColor="{DynamicResource SubTextColor}" FontSize="12" VerticalOptions="Center"/>
                                <Switch x:Name="BringToFrontSwitch" Grid.Column="1" Scale="0.8" OnColor="{DynamicResource AccentColor}" />
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="İndirme Bitince Klasörü Aç" TextColor="{DynamicResource SubTextColor}" FontSize="12" VerticalOptions="Center"/>
                                <Switch x:Name="AutoOpenFolderSwitch" Grid.Column="1" Scale="0.8" OnColor="{DynamicResource AccentColor}" />
                            </Grid>
                        </VerticalStackLayout>

                        <Grid Grid.Column="1" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="🎨 Tema" TextColor="{DynamicResource SubTextColor}" FontSize="11" FontAttributes="Bold" />
                                <Picker x:Name="ThemePicker" FontSize="12" BackgroundColor="{DynamicResource EntryBgColor}" TextColor="{DynamicResource TextColor}" SelectedIndexChanged="OnThemeOrColorChanged">
                                    <Picker.Items>
                                        <x:String>Açık</x:String>
                                        <x:String>Koyu</x:String>
                                        <x:String>OLED</x:String>
                                        <x:String>Matrix</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="✨ Vurgu Rengi" TextColor="{DynamicResource SubTextColor}" FontSize="11" FontAttributes="Bold" />
                                <Picker x:Name="ColorPicker" FontSize="12" BackgroundColor="{DynamicResource EntryBgColor}" TextColor="{DynamicResource TextColor}" SelectedIndexChanged="OnThemeOrColorChanged">
                                    <Picker.Items>
                                        <x:String>Kırmızı</x:String>
                                        <x:String>Turkuaz</x:String>
                                        <x:String>Yeşil</x:String>
                                        <x:String>Mor</x:String>
                                        <x:String>Turuncu</x:String>
                                        <x:String>Pembe</x:String>
                                        <x:String>Mavi</x:String>
                                        <x:String>Sarı</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <Label Text="🎵 Oto Ses" TextColor="{DynamicResource SubTextColor}" FontSize="11" FontAttributes="Bold"/>
                                <Picker x:Name="DefaultAudioPicker" FontSize="12" BackgroundColor="{DynamicResource EntryBgColor}" TextColor="{DynamicResource TextColor}" SelectedIndexChanged="OnDefaultQualityChanged">
                                    <Picker.Items>
                                        <x:String>320 Kbps</x:String>
                                        <x:String>192 Kbps</x:String>
                                        <x:String>128 Kbps</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                <Label Text="🎬 Oto Video" TextColor="{DynamicResource SubTextColor}" FontSize="11" FontAttributes="Bold"/>
                                <Picker x:Name="DefaultVideoPicker" FontSize="12" BackgroundColor="{DynamicResource EntryBgColor}" TextColor="{DynamicResource TextColor}" SelectedIndexChanged="OnDefaultQualityChanged">
                                    <Picker.Items>
                                        <x:String>En İyi</x:String>
                                        <x:String>2160p (4K)</x:String>
                                        <x:String>1440p (2K)</x:String>
                                        <x:String>1080p</x:String>
                                        <x:String>720p</x:String>
                                        <x:String>480p</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- LİNK ARAMA KARTI -->
            <Border BackgroundColor="{DynamicResource PanelBgColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" Padding="8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                    <Entry x:Name="UrlEntry" Placeholder="🔗 YoutTube linkini buraya yapıştırın..." 
                           BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" PlaceholderColor="#888888" HeightRequest="40" FontSize="13" Margin="5,0,0,0"/>
                    <Button Grid.Column="1" Text="📋" BackgroundColor="{DynamicResource EntryBgColor}" TextColor="{DynamicResource TextColor}" 
                            WidthRequest="40" HeightRequest="40" CornerRadius="8" Clicked="OnPasteClicked" ToolTipProperties.Text="Panodan Yapıştır" FontSize="14"/>
                    <Button x:Name="FetchInfoBtn" Grid.Column="2" Text="BUL" BackgroundColor="{DynamicResource AccentColor}" TextColor="White" 
                            FontAttributes="Bold" WidthRequest="75" HeightRequest="40" CornerRadius="8" Clicked="OnFetchInfoClicked" FontSize="13" />
                </Grid>
            </Border>

            <!-- VİDEO BİLGİ KARTI (KOMPAKT) -->
            <Border BackgroundColor="{DynamicResource CardBgColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                    <Border Padding="0" WidthRequest="120" HeightRequest="68" BackgroundColor="#111" Stroke="Transparent">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid>
                            <Image x:Name="ThumbnailImage" Aspect="AspectFill" />
                            <BoxView Color="Black" Opacity="0.2" />
                            <Label Text="▶" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.8"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnThumbnailTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                        <Label x:Name="VideoTitleLabel" Text="Video bekleniyor..." TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="{DynamicResource EntryBgColor}" Stroke="Transparent" Padding="6,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4"/>
                                </Border.StrokeShape>
                                <Label x:Name="VideoDurationLabel" Text="⏱ --:--" TextColor="{DynamicResource SubTextColor}" FontSize="11" FontAttributes="Bold"/>
                            </Border>
                            <Label Text="(Önizlemek için kapağa tıklayın)" TextColor="{DynamicResource SubTextColor}" FontSize="10" VerticalOptions="Center" FontAttributes="Italic"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- YENİ: İNTERAKTİF VE KATLANABİLİR PLAYLIST SEÇİM MENÜSÜ -->
            <Border x:Name="PlaylistSelectionBorder" IsVisible="False" BackgroundColor="{DynamicResource CardBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <!-- Başlık ve + / - Butonu -->
                    <Grid ColumnDefinitions="*, Auto">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="📑 Oynatma Listesi" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label x:Name="PlaylistCountLabel" Text="(0 Video)" TextColor="{DynamicResource AccentColor}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- YENİ: KÜÇÜLTME BÜYÜTME BUTONU -->
                        <Button x:Name="TogglePlaylistBtn" Grid.Column="1" Text="➖" FontSize="12" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" Padding="0" WidthRequest="30" HeightRequest="30" Clicked="OnTogglePlaylistClicked" />
                    </Grid>

                    <!-- Katlanabilir Alan (İndirme Başlayınca veya Butona basılınca gizlenir) -->
                    <VerticalStackLayout x:Name="PlaylistContentContainer" Spacing="10">
                        <HorizontalStackLayout Spacing="5">
                            <CheckBox x:Name="SelectAllCheckBox" IsChecked="True" CheckedChanged="OnSelectAllChanged" Color="{DynamicResource AccentColor}" Scale="0.8"/>
                            <Label Text="Tümünü Seç / Seçimi Kaldır" TextColor="{DynamicResource SubTextColor}" VerticalOptions="Center" FontSize="12"/>
                        </HorizontalStackLayout>

                        <!-- Liste boyutu ekrana göre esnek bırakıldı -->
                        <Border Stroke="{DynamicResource BorderColor}" StrokeThickness="1" BackgroundColor="{DynamicResource EntryBgColor}" HeightRequest="180">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <CollectionView x:Name="PlaylistCollectionView">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto, Auto, *" Padding="8" ColumnSpacing="10">
                                            <CheckBox IsChecked="{Binding IsSelected}" Color="{DynamicResource AccentColor}" VerticalOptions="Center" Scale="0.8"/>
                                            <Border Grid.Column="1" Stroke="Transparent" Padding="0" WidthRequest="60" HeightRequest="34" VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4"/>
                                                </Border.StrokeShape>
                                                <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                                            </Border>
                                            <Label Grid.Column="2" Text="{Binding Title}" VerticalOptions="Center" MaxLines="2" LineBreakMode="TailTruncation" TextColor="{DynamicResource TextColor}" FontSize="12" FontAttributes="Bold" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- BİRLEŞİK, GENİŞ VE FERAH KONTROL PANELİ -->
            <Border BackgroundColor="{DynamicResource PanelBgColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">

                    <!-- 1. Satır: Format ve Kalite Yanyana (Ferah Picker) -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15" VerticalOptions="Center">
                        <Border BackgroundColor="{DynamicResource EntryBgColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="5" Padding="5,0">
                                <RadioButton x:Name="RadioMp3" Content="🎵 MP3" IsChecked="True" TextColor="{DynamicResource TextColor}" FontSize="13" CheckedChanged="OnFormatChanged" VerticalOptions="Center"/>
                                <RadioButton x:Name="RadioMp4" Content="🎬 MP4" TextColor="{DynamicResource TextColor}" FontSize="13" CheckedChanged="OnFormatChanged" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                        <!-- YENİ: Geniş Kalite Kutusu -->
                        <Picker x:Name="QualityPicker" Grid.Column="1" BackgroundColor="{DynamicResource EntryBgColor}" TextColor="{DynamicResource TextColor}" FontSize="14" Title="Kalite Seçin" HorizontalOptions="FillAndExpand"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" />

                    <!-- 2. Satır: Konum Seçimi -->
                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Text="💾 Konum:" TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        <Entry x:Name="FolderEntry" Grid.Column="1" IsReadOnly="True" BackgroundColor="{DynamicResource EntryBgColor}" TextColor="{DynamicResource SubTextColor}" FontSize="12" HeightRequest="38" />
                        <Button Grid.Column="2" Text="📂 Seç" BackgroundColor="{DynamicResource BorderColor}" TextColor="{DynamicResource TextColor}" CornerRadius="8" HeightRequest="38" Clicked="OnSelectFolderClicked" FontSize="12" Padding="10,0"/>
                        <Button Grid.Column="3" Text="Aç" BackgroundColor="{DynamicResource EntryBgColor}" TextColor="{DynamicResource TextColor}" CornerRadius="8" HeightRequest="38" Clicked="OnOpenFolderClicked" FontSize="12" Padding="10,0"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- BAŞLAT VE İPTAL BUTONLARI -->
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" Margin="0,5,0,0">
                <Button x:Name="DownloadBtn" Text="🚀 İNDİRMEYİ BAŞLAT" BackgroundColor="{DynamicResource AccentColor}" TextColor="White" 
                        FontSize="16" FontAttributes="Bold" HeightRequest="50" CornerRadius="10" Clicked="OnDownloadClicked">
                    <Button.Shadow>
                        <Shadow Brush="{DynamicResource AccentColor}" Offset="0,3" Radius="10" Opacity="0.4" />
                    </Button.Shadow>
                </Button>
                <Button x:Name="CancelBtn" Grid.Column="1" Text="✖ İptal Et" BackgroundColor="#444444" TextColor="White" 
                        FontSize="14" FontAttributes="Bold" HeightRequest="50" CornerRadius="10" Clicked="OnCancelClicked" IsVisible="False" Padding="20,0" />
            </Grid>

            <!-- İNDİRME İZLEME PANELİ -->
            <Border x:Name="ProgressContainer" IsVisible="False" BackgroundColor="{DynamicResource CardBgColor}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="CurrentFileLabel" Text="Bağlantı Kuruluyor..." TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" HorizontalOptions="Center" />
                    <ProgressBar x:Name="DownloadProgressBar" Progress="0" ProgressColor="{DynamicResource AccentColor}" HeightRequest="10" />
                    <Label x:Name="ProgressText" Text="Lütfen bekleyin..." TextColor="{DynamicResource SubTextColor}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="StatusLabel" Text="Sistem hazır..." TextColor="{DynamicResource SubTextColor}" HorizontalOptions="Center" FontSize="11" Margin="0,0,0,10"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>